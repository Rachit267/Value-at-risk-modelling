   "source": [
    "## 3. Backtesting\n",
    "Two formal statistical tests applied to each model:\n",
    "- **Kupiec POF Test** — tests whether breach frequency matches expected 1%\n",
    "- **Christoffersen Test** — tests whether breaches are independently distributed\n",
    "Critical value: χ²(1) = 3.841 at 5% significance\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 116,
   "id": "0a90fa04-bf36-4e5f-ae23-b368f0d7360f",
   "metadata": {},
   "outputs": [],
   "source": [
    "actual_returns = log_returns.iloc[window:].values\n",
    "hits_hist = (actual_returns < -hist_var.values).astype(int)\n",
    "hits_param = (actual_returns < -param_var.values).astype(int)\n",
    "hits_mc = (actual_returns < -mc_var.values).astype(int)\n",
    "hits_mc_t = (actual_returns < -mc_t_var.values).astype(int)\n",
    "expected= len(hits_hist)*0.01\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 117,
   "id": "e4ef3bc0-b5fb-4987-8c5e-a969833f8b2d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "18.650000000000002 32 50 50 19\n"
     ]
    }
   ],
   "source": [
    "print(expected, hits_hist.sum(), hits_param.sum(),hits_mc.sum(), hits_mc_t.sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 118,
   "id": "85af933c-6423-4e50-8c5e-b84c59b2cf79",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "7.9497 0.0048 36.453 0.0 36.453 0.0 0.0066 0.9353\n"
     ]
    }
   ],
   "source": [
    "def kupiec_test(hits, n ,confidence=0.99):\n",
    "    p= 1 - confidence\n",
    "    x= hits.sum()\n",
    "    p_hat= x/n\n",
    "    if p_hat == 0 or p_hat ==1:\n",
    "        return None, None\n",
    "    lr= -2* np.log((p**x *(1-p)**(n-x))/(p_hat**x*(1-p_hat)**(n-x)))\n",
    "    p_value = 1- chi2.cdf(lr, df=1)\n",
    "    return round(lr,4), round(p_value, 4)\n",
    "n= len(hits_hist)\n",
    "lr_hist, pv_hist = kupiec_test(hits_hist, n)\n",
    "lr_param, pv_param = kupiec_test(hits_param, n)\n",
    "lr_mc, pv_mc = kupiec_test(hits_mc, n)\n",
    "lr_mc_t, pv_mc_t = kupiec_test(hits_mc_t, n)\n",
    "print(lr_hist, pv_hist,lr_param, pv_param,lr_mc, pv_mc,lr_mc_t, pv_mc_t)\n",
    "                \n",
    "    "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 119,
   "id": "7014b669-3bb4-49ff-967d-dcbe1563c8ed",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "10.0151 0.0016 6.576 0.0103 6.576 0.0103 12.0521 0.0005\n"
     ]
    }
   ],
   "source": [
    "def christoffersen_test(hits):\n",
    "    n= len(hits)\n",
    "    n00= sum((hits[i]==0 and hits[i+1]==0) for i in range (n-1))\n",
    "    n01= sum((hits[i]==0 and hits[i+1]==1) for i in range (n-1))\n",
    "    n10= sum((hits[i]==1 and hits[i+1]==0) for i in range (n-1))\n",
    "    n11= sum((hits[i]==1 and hits[i+1]==1) for i in range (n-1))\n",
    "    if n11==0:\n",
    "        lr_ind= 0.0\n",
    "        p_value= 1.0\n",
    "        return round(lr_ind, 4), round(p_value,4)\n",
    "    pi01= n01/ (n00+n01)\n",
    "    pi11= n11/ (n10+ n11)\n",
    "    pi= (n01+n11)/(n00+n01+n10+n11)\n",
    "    \n",
    "    if pi01==0 or pi11==0 or pi==0:\n",
    "        return None, None\n",
    "    \n",
    "    lr_ind= -2*np.log((pi**(n01+n11)*(1-pi)**(n00+n10))/(pi01**n01*(1-pi01)**n00*pi11**n11*(1-pi11)**n10))\n",
    "    p_value= 1-chi2.cdf(lr_ind, df=1)\n",
    "    return round(lr_ind,4), round(p_value, 4)\n",
    "lr_c_hist, pv_c_hist = christoffersen_test(hits_hist)    \n",
    "lr_c_param, pv_c_param = christoffersen_test(hits_param) \n",
    "lr_c_mc, pv_c_mc = christoffersen_test(hits_mc) \n",
    "lr_c_mc_t, pv_c_mc_t = christoffersen_test(hits_mc_t) \n",
    "print(lr_c_hist, pv_c_hist,lr_c_param, pv_c_param,lr_c_mc, pv_c_mc,lr_c_mc_t, pv_c_mc_t)\n"
   ]
  },
